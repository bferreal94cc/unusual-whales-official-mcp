# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# .env is gitignored — never commit it, and never paste a real key here.
# Values already set in the real environment take precedence over this file.

# Required. Get one at https://unusualwhales.com/api
UW_API_KEY=

# Optional tuning (defaults shown)
# UW_RATE_LIMIT_PER_MINUTE=120
# UW_MAX_RETRIES=3
# UW_CIRCUIT_BREAKER_THRESHOLD=5
# UW_CIRCUIT_BREAKER_RESET_TIMEOUT=30000
# LOG_LEVEL=info
