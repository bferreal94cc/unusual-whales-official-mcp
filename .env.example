# Unusual Whales MCP — environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored. NEVER commit real keys — see docs/secrets.md.

# --- Required ---------------------------------------------------------------

# Your Unusual Whales API key. Get one at https://unusualwhales.com (Account → API).
UW_API_KEY=

# --- Gateway tuning (optional) ----------------------------------------------

# Max outbound requests per minute. Default: 120
UW_RATE_LIMIT_PER_MINUTE=120

# Retry attempts for failed requests. Default: 3
UW_MAX_RETRIES=3

# Consecutive failures before the circuit breaker opens. Default: 5
UW_CIRCUIT_BREAKER_THRESHOLD=5

# Milliseconds before the breaker retries after opening. Default: 30000
UW_CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# --- Premium tools (optional) -----------------------------------------------

# Expose every premium-gated tool. Truthy values: 1, true, yes, on
# Leave unset unless your UW plan covers them.
# UW_ENABLE_PREMIUM_TOOLS=

# Or opt in per catalog / command instead of all at once.
# Comma-separated catalog ids, or "<catalog_id>.<command>" for a single command.
# UW_PREMIUM_TOOLS=

# --- Logging (optional) -----------------------------------------------------

# Verbosity: debug | info | warn | error. Default: info
LOG_LEVEL=info
