# Copy to .env and drop your key in. .env is gitignored — never commit it.
#   cp .env.example .env

# Required. Swap this whenever your key rotates; restart the server to pick it up.
UW_API_KEY=

# Where the data comes from.
#   mcp  — the hosted Unusual Whales MCP server (default)
#   rest — the plain REST API, same data, one less hop
UW_TRANSPORT=mcp

# Optional
PORT=8787
# Seconds to hold a board in memory before refetching. The API is rate limited;
# don't set this below 60 unless you know your plan's limits.
CACHE_TTL=300
# Comma-separated. Any UW-supported ticker works; XSP has no dark pool.
TICKERS=SPY,XSP
